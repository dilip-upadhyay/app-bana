{
  "version": "1.0.0",
  "lastUpdated": "2025-11-08T00:00:00Z",
  "description": "Entity field types, relationships, and entity capabilities",
  
  "fieldTypes": [
    {
      "category": "Text Types",
      "fields": [
        {"type": "text", "sqlType": "VARCHAR(255)", "description": "Short text - names, titles", "validation": ["minLength", "maxLength", "pattern"]},
        {"type": "longtext", "sqlType": "TEXT", "description": "Long text - descriptions, notes", "validation": ["minLength", "maxLength"]},
        {"type": "email", "sqlType": "VARCHAR(255)", "description": "Email with validation", "validation": ["email format"]},
        {"type": "phone", "sqlType": "VARCHAR(20)", "description": "Phone number with formatting", "validation": ["phone format"]},
        {"type": "url", "sqlType": "VARCHAR(500)", "description": "URL with validation", "validation": ["url format"]},
        {"type": "color", "sqlType": "VARCHAR(7)", "description": "Color picker (#RRGGBB)", "validation": ["hex color format"]}
      ]
    },
    {
      "category": "Numeric Types",
      "fields": [
        {"type": "number", "sqlType": "BIGINT", "description": "Integer", "validation": ["min", "max", "step"]},
        {"type": "decimal", "sqlType": "DECIMAL(19,4)", "description": "Decimal/float", "validation": ["min", "max", "step"]},
        {"type": "currency", "sqlType": "DECIMAL(19,4)", "description": "Money amount", "validation": ["min", "max"], "display": "currency symbol"},
        {"type": "percentage", "sqlType": "DECIMAL(5,2)", "description": "Percentage (0-100)", "validation": ["min: 0", "max: 100"]}
      ]
    },
    {
      "category": "Date/Time Types",
      "fields": [
        {"type": "date", "sqlType": "DATE", "description": "Date only", "validation": ["minDate", "maxDate"]},
        {"type": "datetime", "sqlType": "TIMESTAMP", "description": "Date and time", "validation": ["minDate", "maxDate"]},
        {"type": "time", "sqlType": "TIME", "description": "Time only", "validation": []},
        {"type": "duration", "sqlType": "INT", "description": "Duration in minutes", "validation": ["min", "max"]}
      ]
    },
    {
      "category": "Selection Types",
      "fields": [
        {"type": "boolean", "sqlType": "BOOLEAN", "description": "Yes/No checkbox", "validation": []},
        {"type": "status", "sqlType": "VARCHAR(50) + CHECK", "description": "Dropdown with predefined options", "validation": ["allowedValues"]},
        {"type": "radio", "sqlType": "VARCHAR(50) + CHECK", "description": "Radio buttons", "validation": ["allowedValues"]},
        {"type": "multiselect", "sqlType": "JSON", "description": "Multiple selections", "validation": ["allowedValues"]}
      ]
    },
    {
      "category": "Rich Types",
      "fields": [
        {"type": "file", "sqlType": "VARCHAR(500)", "description": "File upload (stores URL/path)", "validation": ["fileType", "maxSize"]},
        {"type": "image", "sqlType": "VARCHAR(500)", "description": "Image upload with preview", "validation": ["imageType", "maxSize"]},
        {"type": "json", "sqlType": "JSON", "description": "JSON data", "validation": []},
        {"type": "markdown", "sqlType": "TEXT", "description": "Markdown editor", "validation": []},
        {"type": "richtext", "sqlType": "TEXT", "description": "WYSIWYG editor", "validation": []}
      ]
    },
    {
      "category": "Relationship Types",
      "fields": [
        {"type": "reference", "sqlType": "BIGINT + FOREIGN KEY", "description": "Links to another entity", "validation": ["targetEntity"]},
        {"type": "lookup", "sqlType": "BIGINT + FOREIGN KEY", "description": "Same as reference but shows related data", "validation": ["targetEntity", "displayField"]}
      ]
    },
    {
      "category": "System/Calculated Types",
      "fields": [
        {"type": "formula", "sqlType": "Computed", "description": "Calculated field", "validation": ["formula expression"]},
        {"type": "autoincrement", "sqlType": "BIGINT AUTO_INCREMENT", "description": "Auto-incrementing ID", "validation": []},
        {"type": "uuid", "sqlType": "VARCHAR(36)", "description": "UUID/GUID", "validation": []},
        {"type": "createdAt", "sqlType": "TIMESTAMP DEFAULT CURRENT_TIMESTAMP", "description": "Auto-set creation timestamp", "validation": []},
        {"type": "updatedAt", "sqlType": "TIMESTAMP ON UPDATE CURRENT_TIMESTAMP", "description": "Auto-update modified timestamp", "validation": []},
        {"type": "createdBy", "sqlType": "BIGINT", "description": "Creator user ID", "validation": []},
        {"type": "updatedBy", "sqlType": "BIGINT", "description": "Modifier user ID", "validation": []}
      ]
    }
  ],

  "fieldValidation": {
    "text": ["required", "minLength", "maxLength", "pattern", "format"],
    "numeric": ["required", "min", "max", "step"],
    "date": ["required", "minDate", "maxDate"],
    "selection": ["required", "allowedValues"],
    "file": ["required", "fileType", "maxSize"],
    "custom": ["customMessage", "customRule"]
  },

  "fieldDisplay": {
    "properties": [
      {"name": "label", "type": "string", "description": "Display label"},
      {"name": "placeholder", "type": "string", "description": "Placeholder text"},
      {"name": "helpText", "type": "string", "description": "Tooltip/help text"},
      {"name": "icon", "type": "string", "description": "Icon (emoji or name)"},
      {"name": "hidden", "type": "boolean", "description": "Hide from forms"},
      {"name": "readOnly", "type": "boolean", "description": "Display only"},
      {"name": "showInTable", "type": "boolean", "description": "Show in list views"},
      {"name": "showInForm", "type": "boolean", "description": "Show in forms"},
      {"name": "showInDetail", "type": "boolean", "description": "Show in detail views"}
    ]
  },

  "relationshipTypes": [
    {
      "type": "one-to-one",
      "description": "One record relates to one other record",
      "example": "User ↔ Profile (one user has one profile)",
      "implementation": "Foreign key in one table",
      "ddl": "FOREIGN KEY (profile_id) REFERENCES profiles(id)"
    },
    {
      "type": "one-to-many",
      "description": "One record relates to many other records",
      "example": "User → Posts (one user has many posts)",
      "implementation": "Foreign key in 'many' table",
      "ddl": "FOREIGN KEY (user_id) REFERENCES users(id)"
    },
    {
      "type": "many-to-one",
      "description": "Many records relate to one other record",
      "example": "Posts → User (many posts belong to one user)",
      "implementation": "Foreign key in source table",
      "ddl": "FOREIGN KEY (user_id) REFERENCES users(id)"
    },
    {
      "type": "many-to-many",
      "description": "Many records relate to many other records",
      "example": "Students ↔ Courses (students take multiple courses, courses have multiple students)",
      "implementation": "Junction table with two foreign keys",
      "ddl": [
        "CREATE TABLE students_courses (",
        "  student_id BIGINT NOT NULL,",
        "  course_id BIGINT NOT NULL,",
        "  FOREIGN KEY (student_id) REFERENCES students(id),",
        "  FOREIGN KEY (course_id) REFERENCES courses(id),",
        "  PRIMARY KEY (student_id, course_id)",
        ")"
      ]
    }
  ],

  "relationshipProperties": {
    "fromEntity": "Source entity name",
    "toEntity": "Target entity name",
    "type": "Relationship type (one-to-one | one-to-many | many-to-one | many-to-many)",
    "fromField": "Source field name (defaults to {entityName}Id)",
    "toField": "Target field name (defaults to 'id')",
    "onDelete": "CASCADE | SET NULL | RESTRICT (default: CASCADE)",
    "name": "Relationship name (optional, for clarity)"
  },

  "autoIncludedFields": [
    {
      "name": "id",
      "type": "autoincrement",
      "sqlType": "BIGINT AUTO_INCREMENT PRIMARY KEY",
      "description": "Every entity automatically gets an ID field",
      "protected": true,
      "cannotModify": true,
      "cannotDelete": true
    }
  ],

  "optionalSystemFields": [
    {
      "name": "deleted",
      "type": "boolean",
      "purpose": "Soft delete support",
      "enabledBy": "softDelete: true in entity config"
    },
    {
      "name": "version",
      "type": "number",
      "purpose": "Versioning support",
      "enabledBy": "versioning: true in entity config"
    }
  ],

  "entityMetaStructure": {
    "file": "src/models/entity-metadata.ts",
    "interface": "EntityMeta",
    "required": ["name", "fields"],
    "optional": ["description", "tableName", "relationships", "softDelete", "versioning", "datasourceType", "datasourceConfig"],
    "example": {
      "name": "User",
      "description": "User accounts",
      "tableName": "users",
      "softDelete": false,
      "versioning": false,
      "datasourceType": "h2",
      "fields": [
        {
          "name": "username",
          "type": "text",
          "required": true,
          "unique": true,
          "validation": {
            "minLength": 3,
            "maxLength": 50
          },
          "display": {
            "label": "Username",
            "placeholder": "Enter username"
          }
        },
        {
          "name": "email",
          "type": "email",
          "required": true,
          "unique": true
        }
      ],
      "relationships": [
        {
          "type": "one-to-many",
          "fromEntity": "User",
          "toEntity": "Post",
          "fromField": "id",
          "toField": "userId",
          "onDelete": "CASCADE"
        }
      ]
    }
  },

  "ddlGeneration": {
    "file": "src/core/EntitySchemaConverter.ts",
    "method": "generateDDL(entityMeta: EntityMeta): string[]",
    "features": [
      "Auto-generates CREATE TABLE statements",
      "Includes primary key (id field)",
      "Includes foreign key constraints",
      "Includes CHECK constraints for status/radio fields",
      "Auto-generates junction tables for many-to-many",
      "Supports CASCADE DELETE"
    ],
    "example": [
      "CREATE TABLE users (",
      "  id BIGINT AUTO_INCREMENT PRIMARY KEY,",
      "  username VARCHAR(255) NOT NULL UNIQUE,",
      "  email VARCHAR(255) NOT NULL UNIQUE",
      ");",
      "",
      "CREATE TABLE posts (",
      "  id BIGINT AUTO_INCREMENT PRIMARY KEY,",
      "  title VARCHAR(255) NOT NULL,",
      "  content TEXT,",
      "  user_id BIGINT NOT NULL,",
      "  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE",
      ");"
    ]
  },

  "backendSync": {
    "file": "src/core/backend-sync.ts",
    "methods": [
      "syncEntityToBackend(entity: EntityMeta): Promise<void>",
      "previewBackendSchema(entity: EntityMeta): Promise<string[]>"
    ],
    "endpoint": "POST /api/schema",
    "flow": [
      "EntityMeta → EntitySchemaConverter → RelationalSchema",
      "RelationalSchema → Backend /api/schema endpoint",
      "Backend → SchemaManager.createSchema()",
      "SchemaManager → DDL execution",
      "Database → Table created"
    ]
  }
}
