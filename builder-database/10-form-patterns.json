{
  "version": "1.1.2",
  "lastUpdated": "2026-08-08T00:00:00Z",
  "description": "Guide for building secure forms with session management and validation. NOTE (S4.3, 2026-08): the CSRF-token-fetching/header flow and 403-CSRF-error handling described in the 'example' below reflect the retired LitElement-era app-bana-ui FormContainer.ts component, not the current backend - CsrfMiddleware was deleted (it was coded but never registered in the live middleware pipeline), and CsrfService/CsrfController remain only as standalone, unconsumed token endpoints. See docs/features/SECURITY_FEATURES.md's CSRF Protection section for the accurate current state.",
  
  "formComponents": {
    "input": {
      "types": ["text", "email", "password", "number", "tel", "url", "date", "datetime-local", "time"],
      "validations": ["required", "min", "max", "pattern"],
      "useCases": {
        "text": ["Name", "Address", "City", "Company", "Job Title"],
        "email": ["User email", "Contact email", "Work email"],
        "password": ["Login password", "New password", "Confirm password"],
        "number": ["Age", "Quantity", "Price", "Rating (1-5)"],
        "tel": ["Phone number", "Mobile", "Fax"],
        "url": ["Website", "Portfolio", "Social media link"],
        "date": ["Birth date", "Hire date", "Event date"],
        "datetime-local": ["Appointment time", "Meeting schedule"],
        "time": ["Start time", "End time", "Opening hours"]
      }
    },
    "textarea": {
      "useCases": ["Description", "Comments", "Bio", "Address (multi-line)", "Message", "Notes"],
      "features": ["Character counter with maxlength", "Resizable", "Multi-line input"]
    },
    "select": {
      "optionsFormat": ["JSON array", "Comma-separated string"],
      "useCases": ["Country", "State", "Category", "Status", "Priority", "Department"],
      "examples": {
        "jsonArray": "[{\"value\":\"us\",\"label\":\"United States\"},{\"value\":\"ca\",\"label\":\"Canada\"}]",
        "commaSeparated": "Active, Inactive, Pending, Archived"
      }
    },
    "checkbox": {
      "useCases": ["Terms agreement", "Newsletter subscription", "Feature toggles", "Preferences"],
      "standalone": true
    },
    "radio-group": {
      "layouts": ["vertical", "horizontal"],
      "useCases": ["Gender selection", "Payment method", "Shipping method", "Plan selection"],
      "optionsFormat": ["JSON array", "Comma-separated string"]
    }
  },

  "formPatterns": {
    "registration": {
      "description": "User registration form",
      "components": [
        {"type": "input", "inputType": "text", "label": "Full Name", "required": true},
        {"type": "input", "inputType": "email", "label": "Email", "required": true},
        {"type": "input", "inputType": "password", "label": "Password", "required": true},
        {"type": "input", "inputType": "password", "label": "Confirm Password", "required": true},
        {"type": "input", "inputType": "tel", "label": "Phone Number"},
        {"type": "input", "inputType": "date", "label": "Birth Date"},
        {"type": "select", "label": "Country", "required": true},
        {"type": "checkbox", "label": "I agree to terms and conditions", "required": true},
        {"type": "button", "label": "Register", "variant": "primary"}
      ]
    },
