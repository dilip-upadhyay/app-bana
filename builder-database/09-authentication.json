    "Permission": {
      "description": "Granular permission defining what actions users can perform",
      "tableName": "permission",
      "fields": [
        {
          "name": "id",
          "type": "number",
          "sqlType": "BIGINT",
          "protected": true
        },
        {
          "name": "resource",
          "type": "text",
          "sqlType": "VARCHAR(100)",
          "required": true,
          "description": "Resource type (entity name or '*' for all)"
        },
        {
          "name": "action",
          "type": "text",
          "sqlType": "VARCHAR(50)",
          "required": true,
          "description": "Action: create, read, update, delete, or '*' for all"
        },
        {
          "name": "scope",
          "type": "text",
          "sqlType": "VARCHAR(50)",
          "required": true,
          "default": "all",
          "description": "Scope: 'all', 'own', 'team'"
        },
        {
          "name": "description",
          "type": "longtext",
          "sqlType": "TEXT",
          "description": "Permission description"
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "sqlType": "TIMESTAMP",
          "protected": true
        }
      ],
      "permissionModel": {
        "format": "resource:action:scope",
        "examples": [
          {
            "permission": "*:*:all",
            "description": "Admin - full access to everything"
          },
          {
            "permission": "Project:read:all",
            "description": "Read all projects"
          },
          {
            "permission": "Project:delete:own",
            "description": "Delete only own projects"
          },
          {
            "permission": "Invoice:create:team",
            "description": "Create invoices for team"
          }
        ],
        "wildcardSupport": true,
        "wildcardRules": [
          "'*' in resource matches any entity",
          "'*' in action matches any CRUD operation",
          "'all' scope overrides 'own' and 'team'"
        ]
      },
      "commonPermissions": [
        {
          "resource": "*",
          "action": "*",
          "scope": "all",
          "description": "Super admin permission"
        },
        {
          "resource": "*",
          "action": "create",
          "scope": "all",
          "description": "Create any resource"
        },
        {
          "resource": "*",
          "action": "read",
          "scope": "all",
          "description": "Read any resource"
        },
        {
          "resource": "*",
          "action": "update",
          "scope": "all",
          "description": "Update any resource"
        },
        {
          "resource": "*",
          "action": "delete",
          "scope": "all",
          "description": "Delete any resource"
        },
        {
          "resource": "*",
          "action": "read",
          "scope": "own",
          "description": "Read own records only"
        },
        {
          "resource": "*",
          "action": "update",
          "scope": "own",
          "description": "Update own records only"
        },
        {
          "resource": "*",
          "action": "delete",
          "scope": "own",
          "description": "Delete own records only"
        }
