      "apiEndpoints": [
        {
          "method": "GET",
          "path": "/api/permissions",
          "description": "List all permissions"
        },
        {
          "method": "POST",
          "path": "/api/permissions",
          "description": "Create new permission (admin only)"
        }
      ]
    },
    "Profile": {
