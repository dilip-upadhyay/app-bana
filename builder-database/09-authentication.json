{
  "version": "1.1.0",
  "lastUpdated": "2025-11-23T00:00:00Z",
  "description": "Authentication, Role-Based Access Control (RBAC), and Field-Level Security (FLS) capabilities",
  "overview": {
    "status": "Available - FLS Production Ready",
    "features": [
      "User Authentication",
      "Role-Based Access Control (RBAC)",
      "Permission Management",
      "Field-Level Security (FLS)",
      "JWT Tokens",
      "Password Security"
    ],
    "implementation": "BCrypt password hashing + JWT tokens + Multi-role RBAC + Field-Level Security with caching",
    "securityLevel": "Enterprise-grade (HIPAA/PCI-DSS ready)",
    "currentGrade": "8.0/10 (Enterprise-Ready)",
    "flsCapabilities": {
      "hideFields": "Can hide sensitive fields (salary, SSN, credit card) from unauthorized roles",
      "readOnly": "Can make fields visible but non-editable (manager sees salary, cannot edit)",
      "wildcardSupport": "Admin role can use '*' wildcard for all fields",
      "multiRole": "OR logic - accessible if ANY role grants permission",
      "performance": "<10ms overhead with 5-minute cache",
      "compliance": "HIPAA (PHI protection), PCI-DSS (cardholder data), ISO 27001 (need-to-know)"
    }
  },
  "authenticationEntities": {
    "User": {
      "description": "Represents an authenticated user with credentials and profile",
      "tableName": "app_user",
      "fields": [
        {
          "name": "id",
          "type": "number",
          "sqlType": "BIGINT",
          "protected": true,
          "description": "Auto-increment primary key"
        },
        {
          "name": "email",
          "type": "email",
          "sqlType": "VARCHAR(255)",
          "unique": true,
          "required": true,
          "description": "User email address (login identifier)"
        },
        {
          "name": "password",
          "type": "password",
          "sqlType": "VARCHAR(255)",
          "required": true,
          "description": "BCrypt hashed password (never return to frontend)"
        },
        {
          "name": "name",
          "type": "text",
          "sqlType": "VARCHAR(255)",
          "required": true,
          "description": "User display name"
        },
        {
          "name": "status",
          "type": "status",
          "sqlType": "VARCHAR(50)",
          "default": "active",
          "allowedValues": [
            "active",
            "inactive",
            "suspended",
            "pending"
          ],
          "description": "Account status"
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "sqlType": "TIMESTAMP",
          "protected": true,
          "description": "Account creation timestamp"
        },
        {
          "name": "lastLogin",
          "type": "datetime",
          "sqlType": "TIMESTAMP",
          "description": "Last successful login timestamp"
        },
        {
          "name": "updatedAt",
          "type": "datetime",
          "sqlType": "TIMESTAMP",
          "protected": true,
          "description": "Last update timestamp"
        }
      ],
      "relationships": [
        {
          "type": "manyToMany",
          "target": "Role",
          "through": "user_role",
          "description": "User can have multiple roles"
        }
      ],
      "securityNotes": [
        "Password field uses BCrypt hash with cost factor 12",
        "toSafeUser() method removes password before sending to frontend",
        "Email must be unique and validated",
        "Status controls account access (only 'active' users can login)"
      ],
      "apiEndpoints": [
        {
          "method": "POST",
          "path": "/api/auth/register",
          "description": "Create new user account"
        },
        {
          "method": "POST",
          "path": "/api/auth/login",
          "description": "Authenticate and receive JWT token"
        },
        {
          "method": "GET",
          "path": "/api/auth/me",
          "description": "Get current authenticated user"
        },
        {
          "method": "PUT",
          "path": "/api/users/:id",
          "description": "Update user profile"
        },
        {
          "method": "GET",
          "path": "/api/users",
          "description": "List users (admin only)"
        }
      ]
    },
    "Role": {
      "description": "Defines a role with a set of permissions",
      "tableName": "role",
      "fields": [
        {
          "name": "id",
          "type": "number",
          "sqlType": "BIGINT",
          "protected": true
        },
        {
          "name": "name",
          "type": "text",
          "sqlType": "VARCHAR(100)",
          "unique": true,
          "required": true,
          "description": "Role name (e.g., 'admin', 'manager', 'user')"
        },
        {
          "name": "description",
          "type": "longtext",
          "sqlType": "TEXT",
          "description": "Role description"
        },
        {
          "name": "isSystem",
          "type": "boolean",
          "sqlType": "BOOLEAN",
          "default": false,
          "description": "System roles cannot be deleted"
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "sqlType": "TIMESTAMP",
          "protected": true
        },
        {
          "name": "updatedAt",
          "type": "datetime",
          "sqlType": "TIMESTAMP",
          "protected": true
        }
      ],
      "relationships": [
        {
          "type": "manyToMany",
          "target": "User",
          "through": "user_role",
          "description": "Role can be assigned to multiple users"
        },
        {
          "type": "manyToMany",
          "target": "Permission",
          "through": "role_permission",
          "description": "Role has multiple permissions"
        }
      ],
      "predefinedRoles": [
        {
          "name": "admin",
          "description": "Full system administrator with all permissions",
          "isSystem": true,
          "permissions": [
            "*:*:all"
          ]
        },
        {
          "name": "manager",
          "description": "Manager with permissions to manage resources",
          "isSystem": true,
          "permissions": [
            "*:create:all",
            "*:read:all",
            "*:update:all",
            "*:delete:own"
          ]
        },
        {
          "name": "user",
          "description": "Standard user with basic read/write access",
          "isSystem": true,
          "permissions": [
            "*:read:all",
            "*:create:own",
            "*:update:own",
            "*:delete:own"
          ]
        }
      ],
      "apiEndpoints": [
