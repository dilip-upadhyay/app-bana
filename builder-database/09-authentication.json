          "method": "GET",
          "path": "/api/roles",
          "description": "List all roles"
        },
        {
          "method": "POST",
          "path": "/api/roles",
          "description": "Create new role (admin only)"
        },
        {
          "method": "PUT",
          "path": "/api/roles/:id",
          "description": "Update role (admin only)"
        },
        {
          "method": "DELETE",
          "path": "/api/roles/:id",
          "description": "Delete non-system role (admin only)"
        },
        {
          "method": "POST",
          "path": "/api/users/:userId/roles/:roleId",
          "description": "Assign role to user (admin only)"
        },
        {
          "method": "DELETE",
          "path": "/api/users/:userId/roles/:roleId",
