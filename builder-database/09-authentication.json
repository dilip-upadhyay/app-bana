  "bestPractices": {
    "security": [
      "Never store plain-text passwords",
      "Always use BCrypt with salt for password hashing",
      "Use JWT tokens with expiration (7 days max)",
      "Validate JWT signature on every protected request",
      "Use HTTPS in production to prevent token interception",
      "Implement rate limiting on login endpoint (prevent brute force)",
      "Log all authentication events for audit trail",
      "Validate password strength on registration",
      "Use constant-time comparison for password verification (prevent timing attacks)"
    ],
    "rbac": [
      "Default to least privilege (deny by default)",
      "Use wildcard permissions sparingly (only for admin)",
      "Prefer scope='own' for user-generated content",
      "System roles (admin, manager, user) cannot be deleted",
      "Check permissions on backend, not just frontend",
      "Frontend hides UI elements, backend enforces permissions",
      "Log permission checks for debugging",
      "Cache user permissions in JWT token to reduce DB queries"
    ],
    "frontend": [
      "Store JWT token in localStorage (or sessionStorage for extra security)",
      "Include 'Authorization: Bearer <token>' header on all API calls",
      "Redirect to login page on 401 Unauthorized",
      "Show 'Permission Denied' message on 403 Forbidden",
      "Use AuthStore singleton for global auth state",
      "Hide sensitive UI elements based on permissions (hasPermission())",
      "Clear token and redirect to login on logout"
    ]
  },
