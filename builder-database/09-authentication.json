  "securityImplementation": {
    "passwordHashing": {
      "algorithm": "BCrypt",
      "costFactor": 12,
      "description": "BCrypt with 2^12 iterations (~250ms per hash)",
      "service": "com.appbana.service.PasswordService",
      "methods": [
        {
          "name": "hashPassword(String plainPassword)",
          "returns": "String",
          "description": "Generate BCrypt hash with random salt"
        },
        {
          "name": "verifyPassword(String plainPassword, String hashedPassword)",
          "returns": "boolean",
          "description": "Verify password against hash (constant-time)"
        },
        {
          "name": "isPasswordStrong(String password)",
          "returns": "boolean",
          "description": "Validate password meets requirements"
        }
      ],
      "passwordRequirements": {
        "minLength": 8,
        "requireUppercase": true,
        "requireLowercase": true,
        "requireDigit": true,
        "requireSpecial": true,
        "description": "Password must be 8+ chars with uppercase, lowercase, digit, and special character"
      }
    },
    "jwtTokens": {
      "algorithm": "HMAC-SHA256",
      "expiration": "7 days",
      "issuer": "appbana",
      "service": "com.appbana.service.JwtService",
      "claims": {
        "subject": "User ID (as string)",
        "email": "User email address",
        "name": "User display name",
        "roles": "Array of role names"
      },
      "methods": [
        {
          "name": "generateToken(Long userId, String email, String name, List<String> roles)",
          "returns": "String",
          "description": "Generate JWT token"
        },
        {
          "name": "verifyToken(String token)",
          "returns": "DecodedJWT",
          "description": "Verify signature and expiration"
        },
        {
          "name": "getUserIdFromToken(String token)",
          "returns": "Long",
          "description": "Extract user ID from token"
        },
        {
          "name": "getEmailFromToken(String token)",
          "returns": "String",
          "description": "Extract email from token"
        },
        {
          "name": "getRolesFromToken(String token)",
          "returns": "List<String>",
          "description": "Extract roles from token"
        },
        {
          "name": "extractTokenFromHeader(String authHeader)",
          "returns": "String",
          "description": "Parse 'Bearer <token>' format"
        }
      ],
      "usage": {
        "frontend": "Store token in localStorage or sessionStorage",
        "apiCalls": "Include 'Authorization: Bearer <token>' header",
        "expiredToken": "Return 401 Unauthorized, frontend redirects to login"
      }
    },
    "authenticationFlow": {
      "registration": [
        "1. User fills registration form (email, password, name)",
        "2. Frontend validates password strength",
        "3. POST /api/auth/register",
        "4. Backend validates email uniqueness",
        "5. Backend hashes password with BCrypt",
        "6. Backend creates user with 'pending' or 'active' status",
        "7. Backend generates JWT token",
        "8. Frontend stores token and redirects to dashboard"
      ],
      "login": [
        "1. User enters email and password",
        "2. POST /api/auth/login",
        "3. Backend finds user by email",
        "4. Backend verifies password with BCrypt",
        "5. Backend checks user status is 'active'",
        "6. Backend updates last_login timestamp",
        "7. Backend generates JWT token with user's roles",
        "8. Frontend stores token and redirects to dashboard"
      ],
      "protectedRequest": [
        "1. Frontend includes 'Authorization: Bearer <token>' header",
        "2. Backend extracts token from header",
        "3. Backend verifies JWT signature and expiration",
        "4. Backend extracts user ID from token",
        "5. Backend loads user and checks status",
        "6. Backend checks permissions for requested action",
        "7. If authorized: process request",
        "8. If unauthorized: return 403 Forbidden"
      ],
      "logout": [
        "1. Frontend removes token from storage",
        "2. Optional: POST /api/auth/logout to invalidate token on server",
        "3. Redirect to login page"
      ]
    },
    "rbacImplementation": {
      "permissionCheck": {
        "method": "hasPermission(userId, resource, action, recordOwnerId)",
        "logic": [
          "1. Load user's roles from user_role table",
          "2. Load all permissions for those roles from role_permission table",
          "3. Check if any permission matches (resource, action, scope)",
          "4. If permission scope is 'own', verify recordOwnerId == userId",
          "5. If permission scope is 'team', verify user is in same team",
          "6. If permission scope is 'all', grant access",
          "7. Wildcard '*' in resource or action matches anything"
        ],
        "examples": [
          {
            "scenario": "Admin deletes any project",
            "userRole": "admin",
            "permission": "*:*:all",
            "request": "DELETE /api/projects/123",
            "result": "Allowed (admin has wildcard permission)"
          },
          {
            "scenario": "Manager updates own project",
            "userRole": "manager",
            "permission": "*:update:all",
            "request": "PUT /api/projects/123",
            "result": "Allowed (manager can update all projects)"
          },
          {
            "scenario": "User deletes own project",
            "userRole": "user",
            "permission": "*:delete:own",
            "request": "DELETE /api/projects/123 (owned by user)",
            "result": "Allowed (user owns the project)"
          },
          {
            "scenario": "User deletes other's project",
            "userRole": "user",
            "permission": "*:delete:own",
            "request": "DELETE /api/projects/456 (owned by someone else)",
            "result": "Denied (user can only delete own projects)"
          }
        ]
      },
      "uiIntegration": {
        "description": "Frontend checks permissions to show/hide UI elements",
        "components": [
          {
            "component": "DataTableElement",
            "feature": "Hide delete button if user lacks delete permission"
          },
          {
            "component": "FormElement",
            "feature": "Disable submit button if user lacks create/update permission"
          },
          {
            "component": "ButtonElement",
            "feature": "Conditional rendering based on hasPermission()"
          },
          {
            "component": "NavigationElement",
            "feature": "Hide menu items based on permissions"
          }
        ],
        "authStore": {
          "file": "src/builder/store/AuthStore.ts",
          "methods": [
            {
              "name": "hasRole(roleName: string)",
              "returns": "boolean",
              "description": "Check if user has specific role"
            },
            {
              "name": "hasPermission(resource: string, action: string)",
              "returns": "boolean",
              "description": "Check if user has specific permission"
            },
            {
              "name": "isAdmin()",
              "returns": "boolean",
              "description": "Check if user is admin"
            },
            {
              "name": "getCurrentUser()",
              "returns": "User | null",
              "description": "Get current authenticated user"
            }
          ]
        }
      }
    }
  },
