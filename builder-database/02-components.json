  "registrationPattern": {
    "file": "src/core/registry.ts",
    "method": "registerComponent(type, constructor)",
    "lazyLoading": true,
    "bootstrap": "ensureCoreRegistered()",
    "example": "registerComponent('my-component', () => import('../components/MyComponent'));"
  },

  "componentStructure": {
    "baseElement": {
      "file": "src/core/BaseElement.ts",
      "pattern": "String-based HTML rendering",
      "lifecycle": ["connectedCallback", "attributeChangedCallback", "render", "styles"],
      "usage": "Legacy - prefer Lit for new components"
    },
    "litElement": {
      "library": "Lit 3.1.4",
      "pattern": "Tagged template literals with html``",
      "reactivity": "@state() decorator",
      "lifecycle": ["connectedCallback", "render"],
      "usage": "Preferred for new components"
    }
  },

  "stylingPatterns": {
    "cssImports": "Always use ?inline suffix: import styles from './Component.css?inline';",
    "shadowDOM": true,
    "designTokens": "Use CSS custom properties from design system",
    "scoping": "All styles are scoped to component via Shadow DOM"
  }
}
