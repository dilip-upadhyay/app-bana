      "category": "Layout Components",
      "file": "src/components/HTMLElements.ts",
      "description": "Semantic HTML footer element",
      "baseClass": "HTMLElement wrapper",
      "props": {},
      "children": true
    },
    {
      "type": "section",
      "name": "SectionElement",
      "category": "Layout Components",
