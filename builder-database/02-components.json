    {
      "type": "studio-table-live",
      "name": "StudioTableLive",
      "category": "Data Components",
      "file": "app-bana-ui/src/runtime/renderer/StudioTableLive.ts",
      "description": "Runtime table shell that renders entity records with pagination, server filters, theming, selection, bulk actions, view/edit modals, and inline cell editing for AI-generated apps.",
      "baseClass": "LitElement",
      "props": {
        "entity": {
          "type": "string",
          "required": true,
          "description": "Entity name (matches backend /api/{entity}) to read/write"
        },
        "fields": {
          "type": "array",
          "description": "Column definitions (name, label, type) to render",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "pageSize": {
          "type": "number",
          "default": 25,
          "description": "Rows per page for server pagination"
        },
        "sort": {
          "type": "string",
          "description": "Optional sort field passed to /api/{entity}"
        },
        "multiSelect": {
          "type": "boolean",
          "default": false,
          "description": "Enables checkbox selection for bulk actions"
        },
        "bulkActions": {
          "type": "array",
          "default": [
            "delete",
            "export"
          ],
          "description": "List of actions (delete/export) shown when rows selected"
        },
        "confirmDelete": {
          "type": "boolean",
          "default": true,
          "description": "Show confirmation modal before bulk delete"
        },
        "actions": {
          "type": "array",
          "description": "Row-level buttons (e.g., \"view\" triggers the view modal)"
        },
        "idField": {
          "type": "string",
          "default": "id",
          "description": "Field used to identify rows for updates"
        },
        "viewMode": {
          "type": "string",
          "values": [
            "dynamic",
            "custom"
          ],
          "default": "dynamic",
          "description": "Determines whether the view modal reuses selected columns or custom field list"
        },
        "viewFormFields": {
          "type": "array",
          "description": "Custom view/edit form definition applied when viewMode=custom"
        },
        "theme": {
          "type": "string",
          "default": "default",
          "values": [
            "default",
            "minimal",
            "dark",
            "striped",
            "compact",
            "soft",
            "auto",
            "custom"
          ],
          "description": "Preset theme; select \"custom\" to override tokens"
        },
        "themeTokens": {
          "type": "object",
          "description": "Optional key/value pairs for custom tokens (headerBg, headerColor, rowEvenBg, rowOddBg, rowHoverBg, cellColor, borderColor, paginationBg, containerBg)"
        }
      },
      "events": [
        {
          "name": "bulk-action",
          "detail": "{ action: string, selectedIds: string[], entity: string }",
          "description": "Fired before executing built-in delete/export"
        },
        {
          "name": "row-view",
          "detail": "{ row: object }",
          "description": "Triggered when view modal opens"
        },
        {
          "name": "cell-edit-start",
          "description": "Inline cell edit session started"
        },
        {
          "name": "cell-edit-cancel",
          "description": "Inline cell edit canceled"
        },
        {
          "name": "cell-edit-save",
          "description": "Inline cell edit saved"
        }
      ],
      "features": [
        "Server-driven pagination with sticky headers and configurable page size",
        "Column filters push queries to backend and harmonize with pagination",
        "Multi select + bulk delete/export with confirm modal and toast feedback",
        "View modal (dynamic/custom) with inline edit mode that writes back via api-client.updateRow",
        "Inline cell editing on double-click with Enter/Escape controls and toasts",
        "Runtime theme presets + custom tokens stored in localStorage"
      ],
      "example": {
        "id": "tableLive1",
        "type": "studio-table-live",
        "props": {
          "entity": "contacts",
          "fields": [
            {
              "name": "id",
              "label": "ID",
              "type": "text"
            },
            {
              "name": "name",
              "label": "Name",
              "type": "text"
            },
            {
              "name": "email",
              "label": "Email",
              "type": "text"
            },
            {
              "name": "status",
              "label": "Status",
              "type": "text"
            }
          ],
          "pageSize": 25,
          "multiSelect": true,
          "actions": [
            "view"
          ],
          "bulkActions": [
            "delete",
            "export"
          ],
          "confirmDelete": true,
          "viewMode": "dynamic",
          "theme": "default"
        }
      }
    },
