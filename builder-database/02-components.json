    {
      "type": "container",
      "name": "ContainerElement",
      "category": "Layout Components",
      "file": "src/components/ContainerElement.ts",
      "description": "Generic container for grouping child components with layout control",
      "baseClass": "BaseElement",
      "props": {
        "layout": {
          "type": "string",
          "values": [
            "vertical",
            "horizontal",
            "grid"
          ],
          "default": "vertical",
          "description": "Layout direction for children"
        },
        "gap": {
          "type": "string",
          "values": [
            "sm",
            "md",
            "lg"
          ],
          "default": "md",
          "description": "Spacing between children"
        },
        "padding": {
          "type": "string",
          "values": [
            "none",
            "sm",
            "md",
            "lg"
          ],
          "default": "md",
          "description": "Internal padding"
        },
        "align": {
          "type": "string",
          "values": [
            "start",
            "center",
            "end",
            "stretch"
          ],
          "default": "stretch",
          "description": "Cross-axis alignment"
        },
        "wrap": {
          "type": "string",
          "values": [
            "nowrap",
            "wrap",
            "wrap-reverse"
          ],
          "default": "nowrap",
          "description": "Flex wrap behavior"
        }
      },
      "children": true,
      "example": {
        "id": "container1",
        "type": "container",
        "props": {
          "layout": "vertical",
          "gap": "md",
          "padding": "lg"
        },
        "children": [
          "child1",
          "child2"
        ]
      }
    },
    {
      "type": "studio-form",
      "name": "FormContainer",
      "category": "Form Components",
      "file": "src/components/FormContainer.ts",
      "description": "Container that handles data loading and submission for an entity record.",
      "baseClass": "BaseElement",
      "customElement": "studio-form",
      "props": {
        "entity": {
          "type": "string",
          "required": true,
          "description": "Entity name to create/update (e.g. 'Customer')"
        },
        "record-id": {
          "type": "string",
          "description": "ID of record to update. If omitted, creates new record."
        },
        "redirect-on-success": {
          "type": "string",
          "description": "Path to navigate to after successful save (e.g. '/customers')"
        },
        "title": {
          "type": "string",
          "description": "Form title displayed in header"
        },
        "submitLabel": {
          "type": "string",
          "default": "Save",
          "description": "Text label for the submit button"
        },
        "layout": {
          "type": "string",
          "values": [
            "vertical",
            "horizontal"
          ],
          "default": "vertical",
          "description": "Layout direction of form fields"
        },
        "apiUrl": {
          "type": "string",
          "description": "Optional custom API endpoint override"
        }
      },
      "children": true,
      "features": [
        "Auto-load record data",
        "Auto-collect input values",
        "Handies API submission",
        "Show/Hide success/error messages"
      ],
      "example": {
        "id": "form1",
        "type": "studio-form",
        "props": {
          "entity": "Ticket",
          "redirect-on-success": "/tickets"
        },
        "children": [
          "input-title",
          "textarea-desc",
          "btn-submit"
        ]
      }
    },
