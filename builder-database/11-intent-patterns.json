{
  "metaVersion": "1.0",
  "description": "Intent classification patterns - defines AI Builder's intelligence through metadata",
  "lastUpdated": "2025-11-20",
  "intents": [
    {
      "id": "create_app",
      "name": "Create Application",
      "description": "User wants to create a new app from scratch",
      "confidence_threshold": 0.75,
      "patterns": [
        {
          "type": "keyword",
          "keywords": [
            "create",
            "build",
            "generate",
            "make",
            "develop",
            "start",
            "new"
          ],
          "must_contain": [
            "app",
            "application"
          ],
          "weight": 0.9
        },
        {
          "type": "keyword",
          "keywords": [
            "want",
            "need",
            "like to",
            "thinking"
          ],
          "must_contain": [
            "app",
            "application"
          ],
          "weight": 0.75
        }
      ],
      "context_boosters": [
        {
          "condition": "no_active_app",
          "boost": 0.1,
          "description": "Boost if no app is currently being discussed"
        }
      ],
      "required_entities": [
        "app_type"
      ],
      "actions": [
        "generate_app_structure"
      ]
    },
    {
      "id": "refine_app",
      "name": "Refine/Modify App Structure",
      "description": "User asking about or wanting to modify the proposed app structure",
      "confidence_threshold": 0.70,
      "patterns": [
        {
          "type": "question_word",
          "keywords": [
            "where",
            "how",
            "what about",
            "can you",
            "could you"
          ],
          "context_required": "last_discussed_app",
          "weight": 0.7
        },
        {
          "type": "keyword",
          "keywords": [
            "add",
            "include",
            "modify",
            "change",
            "update",
            "remove"
          ],
          "context_required": "last_discussed_app",
          "weight": 0.75
        },
        {
          "type": "entity_overlap",
          "min_overlap": 1,
          "source": "discussed_entities",
          "weight": 0.85,
          "description": "Check if user mentions entities from current app discussion"
        },
        {
          "type": "keyword",
          "keywords": [
            "option",
            "feature",
            "page",
            "field",
            "entity",
            "registration",
            "register"
          ],
          "context_required": "last_discussed_app",
          "weight": 0.7
        }
      ],
      "context_boosters": [
        {
          "condition": "has_active_app_discussion",
          "boost": 0.15,
          "description": "Strong boost if actively discussing an app"
        },
        {
          "condition": "recent_app_structure_shown",
          "boost": 0.12,
          "description": "Boost if app structure was just displayed"
        }
      ],
      "actions": [
        "update_entity",
        "add_page",
        "modify_field",
        "regenerate_structure"
      ],
      "clarification_prompts": {
        "low_confidence": "I see you want to modify the app. Could you clarify what specific change you'd like?"
      }
    },
    {
      "id": "approve_continue",
      "name": "Approve & Continue",
      "description": "User approves the proposed structure and wants to proceed",
      "confidence_threshold": 0.80,
      "patterns": [
        {
          "type": "approval_phrase",
          "exact_matches": [
            "looks good",
            "looks ok",
            "looks okay",
            "looks great",
            "looks fine",
            "sounds good",
            "sounds ok",
            "sounds okay",
            "sounds great",
            "sounds fine",
            "that's fine",
            "that's good",
            "that's great",
            "that works",
            "that's perfect",
            "perfect",
            "excellent",
            "awesome",
            "nice",
            "cool",
            "yes",
            "yep",
            "yeah",
            "sure",
            "ok",
            "okay",
            "i like it",
            "i love it",
            "i agree",
            "go ahead",
            "proceed",
            "continue",
            "yes create it",
            "create it",
            "build it",
            "make it"
          ],
          "weight": 1.0
        },
        {
          "type": "keyword",
          "keywords": [
            "go ahead",
            "proceed",
            "continue",
            "yes"
          ],
          "must_contain": [
            "create",
            "build",
            "make",
            "generate"
          ],
          "weight": 0.95
        }
      ],
      "context_requirements": {
        "must_have": "last_discussed_app_description",
        "action": "create_from_context"
      },
      "context_boosters": [
        {
          "condition": "structure_just_shown",
          "boost": 0.15,
          "description": "High confidence if structure was just displayed"
        }
      ],
      "actions": [
        "create_app_from_context"
      ]
    },
    {
      "id": "list_apps",
      "name": "List Applications",
      "description": "User wants to see all their apps",
      "confidence_threshold": 0.85,
      "patterns": [
        {
          "type": "keyword",
          "exact_matches": [
            "apps",
            "my apps",
            "list apps",
            "show apps",
            "all apps"
          ],
          "weight": 1.0
        },
        {
          "type": "keyword",
          "keywords": [
            "show",
            "list",
            "display",
            "view",
            "see"
          ],
          "must_contain": [
            "apps",
            "applications"
          ],
          "weight": 0.9
        }
      ],
      "actions": [
        "list_all_apps"
      ]
    },
    {
      "id": "load_app",
      "name": "Load/Open Application",
      "description": "User wants to open a specific app",
      "confidence_threshold": 0.85,
      "patterns": [
        {
          "type": "keyword",
          "keywords": [
            "open",
            "load",
            "show",
            "view",
            "select"
          ],
          "must_contain": [
            "app",
            "application"
          ],
          "weight": 0.9
        },
        {
          "type": "ordinal",
          "keywords": [
            "first",
            "second",
            "third",
            "1st",
            "2nd",
            "3rd"
          ],
          "must_contain": [
            "app"
          ],
          "weight": 0.95
        }
      ],
      "actions": [
        "open_app_by_index",
        "open_app_by_name"
      ]
    },
    {
      "id": "describe_app",
      "name": "Describe/Explain App",
      "description": "User wants an overview or explanation of the current app",
      "confidence_threshold": 0.80,
      "patterns": [
        {
          "type": "keyword",
          "keywords": [
            "describe",
            "explain",
            "explian",
            "overview",
            "summary",
            "stats",
            "tell me about"
          ],
          "must_contain": [
            "app",
            "application",
            "this",
            "it"
          ],
          "weight": 0.95
        },
        {
          "type": "exact_match",
          "exact_matches": [
            "explain app",
            "describe app",
            "app overview",
            "app summary",
            "what is this app"
          ],
          "weight": 1.0
        },
        {
          "type": "question_word",
          "keywords": [
            "what is",
            "how does"
          ],
          "must_contain": [
            "app",
            "work"
          ],
          "context_required": "lastDiscussedAppDescription",
          "weight": 0.85
        }
      ],
      "context_boosters": [
        {
          "condition": "has_active_app_discussion",
          "boost": 0.2,
          "description": "Boost if we are already talking about an app"
        }
      ],
      "actions": [
        "describeApp"
      ]
    },
    {
      "id": "delete_app",
      "name": "Delete Application",
      "description": "User wants to delete/remove an app",
      "confidence_threshold": 0.90,
      "patterns": [
        {
          "type": "keyword",
          "keywords": [
            "delete",
            "remove",
            "destroy",
            "erase",
            "trash"
          ],
          "must_contain": [
            "app",
            "application",
            "this"
          ],
          "weight": 0.95
        },
        {
          "type": "exact_match",
          "exact_matches": [
            "delete app",
            "remove app",
            "delete this app"
          ],
          "weight": 1.0
        }
      ],
      "actions": [
        "deleteApp"
      ]
    },
    {
      "id": "list_pages",
      "name": "List Pages",
      "description": "User wants to see pages in an app",
      "confidence_threshold": 0.85,
      "patterns": [
        {
          "type": "keyword",
          "keywords": [
            "list",
            "show",
            "display",
            "view",
            "get",
            "how many",
            "count"
          ],
          "must_contain": [
            "pages",
            "page"
          ],
          "weight": 0.9
        },
        {
          "type": "exact_match",
          "exact_matches": [
            "list pages",
            "show pages",
            "what pages"
          ],
          "weight": 1.0
        }
      ],
      "context_boosters": [
        {
          "condition": "has_active_app_discussion",
          "boost": 0.1,
          "description": "Boost if discussing an app"
        }
      ],
      "actions": [
        "listPages"
      ]
    },
    {
      "id": "request_final_version",
      "name": "Request Final App Structure",
      "description": "User asking to see the complete/final version of the app",
      "confidence_threshold": 0.75,
      "patterns": [
        {
          "type": "keyword",
          "keywords": [
            "final",
            "complete",
            "full"
          ],
          "must_contain": [
            "version",
            "structure",
            "design",
            "app"
          ],
          "weight": 0.85
        },
        {
          "type": "keyword",
          "keywords": [
            "give me",
            "show me"
          ],
          "must_contain": [
            "app",
            "application",
            "version"
          ],
          "weight": 0.8
        }
      ],
      "context_requirements": {
        "must_have": "last_discussed_app_description"
      },
      "actions": [
        "show_app_structure",
        "regenerate_structure"
      ]
    },
    {
      "id": "refactor_entity",
      "name": "Refactor Entity",
      "description": "User wants to rename, modify, or change fields of an existing entity",
      "confidence_threshold": 0.75,
      "patterns": [
        {
          "type": "keyword",
          "keywords": [
            "rename",
            "modify",
            "change",
            "update",
            "edit",
            "convert"
          ],
          "must_contain": [
            "entity",
            "field",
            "type",
            "column"
          ],
          "weight": 0.85
        },
        {
          "type": "entity_overlap",
          "min_overlap": 1,
          "source": "discussed_entities",
          "weight": 0.9,
          "description": "Boost if modifying an entity we are talking about"
        }
      ],
      "actions": [
        "refactor_entity"
      ]
    },
    {
      "id": "add_relationship",
      "name": "Add Relationship",
      "description": "User wants to create a relationship between two entities",
      "confidence_threshold": 0.75,
      "patterns": [
        {
          "type": "keyword",
          "keywords": [
            "link",
            "connect",
            "relationship",
            "relate",
            "associate",
            "bind"
          ],
          "weight": 0.85
        },
        {
          "type": "keyword",
          "keywords": [
            "has many",
            "belongs to",
            "one to one",
            "one to many",
            "many to many"
          ],
          "weight": 0.95
        }
      ],
      "actions": [
        "create_relationship"
      ]
    },
    {
      "id": "greeting",
      "name": "Greeting",
      "description": "Simple greetings and pleasantries",
      "confidence_threshold": 0.95,
      "patterns": [
        {
          "type": "exact_match",
          "exact_matches": [
            "hi",
            "hello",
            "hey",
            "hiya",
            "howdy",
            "greetings",
            "good morning",
            "good afternoon",
            "good evening",
            "how are you",
            "how's it going",
            "what's up"
          ],
          "weight": 1.0
        }
      ],
      "actions": [
        "send_greeting"
      ],
      "skip_gpt": true
    },
    {
      "id": "smalltalk",
      "name": "Small Talk",
      "description": "General chit-chat not related to app building",
      "confidence_threshold": 0.70,
      "patterns": [
        {
          "type": "keyword",
          "keywords": [
            "can you",
            "do you"
          ],
          "must_contain": [
            "sing",
            "dance",
            "cook",
            "play",
            "swim",
            "run"
          ],
          "weight": 0.85
        }
      ],
      "actions": [
        "handle_smalltalk"
      ],
      "use_smalltalk_engine": true
    },
    {
      "id": "field_level_security",
      "name": "Field-Level Security (FLS)",
      "description": "User wants to hide/protect/restrict access to specific fields based on roles",
      "confidence_threshold": 0.75,
      "patterns": [
        {
          "type": "keyword",
          "keywords": [
            "hide",
            "protect",
            "restrict",
            "secure",
            "lock",
            "mask"
          ],
          "must_contain": [
            "field",
            "column",
            "attribute",
            "property",
            "data"
          ],
          "weight": 0.9
        },
        {
          "type": "keyword",
          "keywords": [
            "only",
            "can't see",
            "cannot see",
            "shouldn't see",
            "shouldn't access"
          ],
          "context_required": "role_context",
          "weight": 0.85
        },
        {
          "type": "security_keywords",
          "keywords": [
            "salary",
            "ssn",
            "social security",
            "credit card",
            "password",
            "confidential",
            "sensitive",
            "private",
            "phi",
            "pii"
          ],
          "weight": 0.95
        },
        {
          "type": "compliance_keywords",
          "keywords": [
            "hipaa",
            "pci-dss",
            "gdpr",
            "compliance",
            "audit",
            "regulatory"
          ],
          "weight": 0.9
        }
      ],
      "examples": [
        "Hide salary field from non-HR users",
        "Only managers can see employee SSN",
        "Protect patient medical records (HIPAA)",
        "Nurses cannot see patient billing information",
        "Make salary read-only for managers",
        "HR can edit benefits, managers can only view"
      ],
      "actions": [
        "suggest_field_permission",
        "create_field_permission_records"
      ],
      "response_template": "I can configure Field-Level Security to {action} the '{field}' field for {role}. This will ensure HIPAA/PCI-DSS compliance. Shall I create the field permission?",
      "technical_implementation": {
        "entity": "FieldPermission",
        "table": "field_permission",
        "fields": [
          "role_id",
          "entity_name",
          "field_name",
          "readable",
          "editable"
        ],
        "apiEndpoints": [
          "POST /api/field-permissions",
          "GET /api/field-permissions/readable?entity=User",
          "GET /api/field-permissions/editable?entity=User"
        ],
        "uiComponent": "StudioTableLive automatically hides/disables fields"
      }
    }
  ],
  "fallback_strategy": {
    "confidence_below": 0.50,
    "action": "use_gpt",
    "include_context": true,
    "log_for_learning": true
  },
  "learning_config": {
    "enabled": true,
    "correction_threshold": 3,
    "auto_update_patterns": false,
    "feedback_weight": 0.1,
    "suggestions_file": "builder-database/11-intent-patterns-suggestions.json"
  }
}