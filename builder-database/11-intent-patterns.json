{
  "metaVersion": "1.0",
  "description": "Intent classification patterns - defines AI Builder's intelligence through metadata",
  "lastUpdated": "2025-11-20",
  "intents": [
    {
      "id": "create_app",
      "name": "Create Application",
      "description": "User wants to create a new app from scratch",
      "confidence_threshold": 0.75,
      "patterns": [
        {
          "type": "keyword",
          "keywords": ["create", "build", "generate", "make", "develop", "start", "new"],
          "must_contain": ["app", "application"],
          "weight": 0.9
        },
        {
          "type": "keyword",
          "keywords": ["want", "need", "like to", "thinking"],
          "must_contain": ["app", "application"],
          "weight": 0.75
        }
      ],
      "context_boosters": [
        {
          "condition": "no_active_app",
          "boost": 0.1,
          "description": "Boost if no app is currently being discussed"
        }
      ],
      "required_entities": ["app_type"],
      "actions": ["generate_app_structure"]
    },
    {
      "id": "refine_app",
      "name": "Refine/Modify App Structure",
      "description": "User asking about or wanting to modify the proposed app structure",
      "confidence_threshold": 0.70,
      "patterns": [
        {
          "type": "question_word",
          "keywords": ["where", "how", "what about", "can you", "could you"],
          "context_required": "last_discussed_app",
          "weight": 0.7
        },
        {
          "type": "keyword",
          "keywords": ["add", "include", "modify", "change", "update", "remove"],
          "context_required": "last_discussed_app",
          "weight": 0.75
        },
        {
          "type": "entity_overlap",
          "min_overlap": 1,
          "source": "discussed_entities",
          "weight": 0.85,
          "description": "Check if user mentions entities from current app discussion"
        },
        {
          "type": "keyword",
          "keywords": ["option", "feature", "page", "field", "entity", "registration", "register"],
          "context_required": "last_discussed_app",
          "weight": 0.7
        }
      ],
      "context_boosters": [
        {
          "condition": "has_active_app_discussion",
          "boost": 0.15,
          "description": "Strong boost if actively discussing an app"
        },
        {
          "condition": "recent_app_structure_shown",
          "boost": 0.12,
          "description": "Boost if app structure was just displayed"
        }
      ],
      "actions": ["update_entity", "add_page", "modify_field", "regenerate_structure"],
      "clarification_prompts": {
        "low_confidence": "I see you want to modify the app. Could you clarify what specific change you'd like?"
      }
    },
    {
      "id": "approve_continue",
      "name": "Approve & Continue",
      "description": "User approves the proposed structure and wants to proceed",
      "confidence_threshold": 0.80,
      "patterns": [
        {
          "type": "approval_phrase",
          "exact_matches": [
            "looks good", "looks ok", "looks okay", "looks great", "looks fine",
            "sounds good", "sounds ok", "sounds okay", "sounds great", "sounds fine",
            "that's fine", "that's good", "that's great", "that works", "that's perfect",
            "perfect", "excellent", "awesome", "nice", "cool",
            "yes", "yep", "yeah", "sure", "ok", "okay",
            "i like it", "i love it", "i agree",
            "go ahead", "proceed", "continue",
            "yes create it", "create it", "build it", "make it"
          ],
          "weight": 1.0
        },
        {
          "type": "keyword",
          "keywords": ["go ahead", "proceed", "continue", "yes"],
          "must_contain": ["create", "build", "make", "generate"],
          "weight": 0.95
        }
      ],
      "context_requirements": {
        "must_have": "last_discussed_app_description",
        "action": "create_from_context"
      },
      "context_boosters": [
        {
          "condition": "structure_just_shown",
          "boost": 0.15,
          "description": "High confidence if structure was just displayed"
        }
      ],
      "actions": ["create_app_from_context"]
    },
    {
      "id": "list_apps",
      "name": "List Applications",
      "description": "User wants to see all their apps",
      "confidence_threshold": 0.85,
      "patterns": [
        {
          "type": "keyword",
          "exact_matches": ["apps", "my apps", "list apps", "show apps", "all apps"],
          "weight": 1.0
        },
        {
          "type": "keyword",
          "keywords": ["show", "list", "display", "view", "see"],
          "must_contain": ["apps", "applications"],
          "weight": 0.9
        }
      ],
      "actions": ["list_all_apps"]
    },
    {
      "id": "load_app",
      "name": "Load/Open Application",
      "description": "User wants to open a specific app",
      "confidence_threshold": 0.85,
      "patterns": [
        {
          "type": "keyword",
          "keywords": ["open", "load", "show", "view", "select"],
          "must_contain": ["app", "application"],
          "weight": 0.9
        },
        {
          "type": "ordinal",
          "keywords": ["first", "second", "third", "1st", "2nd", "3rd"],
          "must_contain": ["app"],
          "weight": 0.95
        }
      ],
      "actions": ["open_app_by_index", "open_app_by_name"]
    },
    {
      "id": "request_final_version",
      "name": "Request Final App Structure",
      "description": "User asking to see the complete/final version of the app",
      "confidence_threshold": 0.75,
      "patterns": [
        {
          "type": "keyword",
          "keywords": ["final", "complete", "full"],
          "must_contain": ["version", "structure", "design", "app"],
          "weight": 0.85
        },
        {
          "type": "keyword",
          "keywords": ["give me", "show me"],
          "must_contain": ["app", "application", "version"],
          "weight": 0.8
        }
      ],
      "context_requirements": {
        "must_have": "last_discussed_app_description"
      },
      "actions": ["show_app_structure", "regenerate_structure"]
    },
    {
      "id": "greeting",
      "name": "Greeting",
      "description": "Simple greetings and pleasantries",
      "confidence_threshold": 0.95,
      "patterns": [
        {
          "type": "exact_match",
          "exact_matches": [
            "hi", "hello", "hey", "hiya", "howdy", "greetings",
            "good morning", "good afternoon", "good evening",
            "how are you", "how's it going", "what's up"
          ],
          "weight": 1.0
        }
      ],
      "actions": ["send_greeting"],
      "skip_gpt": true
    },
    {
      "id": "smalltalk",
      "name": "Small Talk",
      "description": "General chit-chat not related to app building",
      "confidence_threshold": 0.70,
      "patterns": [
        {
          "type": "keyword",
          "keywords": ["can you", "do you"],
          "must_contain": ["sing", "dance", "cook", "play", "swim", "run"],
          "weight": 0.85
        }
      ],
      "actions": ["handle_smalltalk"],
      "use_smalltalk_engine": true
    }
  ],
  "fallback_strategy": {
    "confidence_below": 0.50,
    "action": "use_gpt",
    "include_context": true,
    "log_for_learning": true
  },
  "learning_config": {
    "enabled": true,
    "correction_threshold": 3,
    "auto_update_patterns": false,
    "feedback_weight": 0.1,
    "suggestions_file": "builder-database/11-intent-patterns-suggestions.json"
  }
}
