{
  "version": "1.1.0",
  "lastUpdated": "2025-12-10T00:00:00Z",
  "description": "Complete REST API reference for AppBana backend",
  "baseURL": "http://localhost:8080",
  "server": "JDK HttpServer",
  "file": "app-bana-service/src/main/java/com/appbana/ApiServer.java",
  "endpoints": {
    "apps": [
      {
        "method": "GET",
        "path": "/apps",
        "description": "List all apps (summary info)",
        "response": "{ apps: [{id, name, description, version, created, updated, pageCount}] }",
        "status": 200
      },
      {
        "method": "POST",
        "path": "/apps",
        "description": "Create new app",
        "body": "{id, name, description, version, pages: []}",
        "response": "AppMetadata",
        "status": 200,
        "notes": "Creates apps/{appId}/ directory and app.json file"
      },
      {
        "method": "GET",
        "path": "/apps/{appId}",
        "description": "Get full app metadata",
        "response": "AppMetadata",
        "status": 200
      },
      {
        "method": "PUT",
        "path": "/apps/{appId}",
        "description": "Update app metadata",
        "body": "Partial AppMetadata",
        "response": "Updated AppMetadata",
        "status": 200,
        "notes": "Updates timestamp automatically"
      },
      {
        "method": "DELETE",
        "path": "/apps/{appId}",
        "description": "Delete app and all its pages",
        "response": "{success: true}",
        "status": 200,
        "notes": "Recursively deletes apps/{appId}/ directory"
      }
    ],
    "pages": [
      {
        "method": "GET",
        "path": "/apps/{appId}/pages/{pageId}",
        "description": "Get page metadata",
        "response": "PageMeta (Map<String, Object>)",
        "status": 200
      },
      {
        "method": "PUT",
        "path": "/apps/{appId}/pages/{pageId}",
        "description": "Save page metadata",
        "body": "PageMeta",
        "response": "Saved PageMeta",
        "status": 200,
        "notes": "AUTO-UPDATES app.pages[] if pageId not present. Creates pages/ directory if needed."
      },
      {
        "method": "DELETE",
        "path": "/apps/{appId}/pages/{pageId}",
        "description": "Delete page",
        "response": "{success: true}",
        "status": 200,
        "notes": "AUTO-REMOVES pageId from app.pages[]. Deletes pages/{pageId}.json file."
      }
    ],
    "schema": [
      {
        "method": "POST",
        "path": "/api/schema",
        "description": "Create entity schema (DDL execution)",
        "body": "EntitySchema",
        "response": "{success: true, message: 'Schema created'}",
        "status": 200,
        "notes": "Executes CREATE TABLE DDL, creates schema metadata"
      },
      {
        "method": "GET",
        "path": "/api/schema",
        "description": "List all schemas",
        "response": "EntitySchema[]",
        "status": 200
      },
      {
        "method": "GET",
        "path": "/api/schema/{name}",
        "description": "Get schema by name",
        "response": "EntitySchema",
        "status": 200
      },
      {
        "method": "DELETE",
        "path": "/api/schema/{name}",
        "description": "Delete schema",
        "query": "?dropTable=true (optional)",
        "response": "{success: true}",
        "status": 200,
        "notes": "Optionally drops underlying table if dropTable=true"
      },
      {
        "method": "GET",
        "path": "/api/schema/{name}/migrations",
        "description": "Get schema migration history",
        "response": "Migration[]",
        "status": 200
      }
    ],
    "crud": [
      {
        "method": "GET",
        "path": "/api/{entity}",
        "description": "Query entity records",
        "query": "?limit=10&offset=0&sort=createdAt&order=desc",
        "response": "[{record1}, {record2}, ...]",
        "status": 200
      },
      {
        "method": "GET",
        "path": "/api/{entity}/{id}",
        "description": "Get single record by ID",
        "response": "{record}",
        "status": 200
      },
      {
        "method": "POST",
        "path": "/api/{entity}",
        "description": "Create new record",
        "body": "{field1: value1, field2: value2}",
        "response": "Created record with ID",
        "status": 200,
        "notes": "Triggers audit log (INSERT)"
      },
      {
        "method": "PUT",
        "path": "/api/{entity}/{id}",
        "description": "Update record",
        "body": "{field1: newValue1}",
        "response": "{success: true}",
        "status": 200,
        "notes": "Triggers audit log (UPDATE with before/after diff)"
      },
      {
        "method": "DELETE",
        "path": "/api/{entity}/{id}",
        "description": "Delete record",
        "response": "{success: true}",
        "status": 200,
        "notes": "Triggers audit log (DELETE with old values)"
      }
    ],
    "audit": [
      {
        "method": "GET",
        "path": "/audit",
        "description": "Query audit logs",
        "query": "?entity=users&action=INSERT&limit=100",
        "response": "AuditLog[]",
        "status": 200,
        "filters": [
          "entity",
          "action",
          "userId",
          "startDate",
          "endDate",
          "limit",
          "offset"
        ]
      }
    ],
    "datasources": [
      {
        "method": "GET",
        "path": "/ui/datasource",
        "description": "List all datasources",
        "response": "Datasource[]",
        "status": 200
      },
      {
        "method": "POST",
        "path": "/ui/datasource",
        "description": "Add datasource",
        "body": "DatasourceConfig",
        "response": "Created datasource",
        "status": 200
      },
      {
        "method": "PUT",
        "path": "/ui/datasource",
        "description": "Update datasource",
        "body": "DatasourceConfig",
        "response": "Updated datasource",
        "status": 200
      },
      {
        "method": "DELETE",
        "path": "/ui/datasource/{name}",
        "description": "Delete datasource",
        "response": "{success: true}",
        "status": 200
      },
      {
        "method": "POST",
        "path": "/ui/datasource/test",
        "description": "Test datasource connection",
        "body": "DatasourceConfig",
        "response": "{success: true, message: 'Connected successfully'}",
        "status": 200
      }
    ],
    "openapi": [
      {
        "method": "GET",
        "path": "/openapi.json",
        "description": "OpenAPI 3.0 specification",
        "response": "OpenAPI spec JSON",
        "status": 200
      },
      {
        "method": "GET",
        "path": "/ui/swagger",
        "description": "Swagger UI",
        "response": "HTML page with Swagger UI",
        "status": 200
      }
    ],
    "workflows": [
      {
        "method": "GET",
        "path": "/api/workflows",
        "description": "List all workflow definitions",
        "query": "?appId={id}&status={status}&triggerEntity={entity}",
        "response": "[{id, name, version, status, triggerEntity}]",
        "status": 200
      },
      {
        "method": "POST",
        "path": "/api/workflows",
        "description": "Create or update workflow definition",
        "body": "WorkflowDefinition (JSON)",
        "response": "WorkflowDefinition",
        "status": 200
      },
      {
        "method": "GET",
        "path": "/api/workflows/{id}",
        "description": "Get specific workflow definition",
        "response": "WorkflowDefinition",
        "status": 200
      },
      {
        "method": "POST",
        "path": "/api/workflows/{id}/publish",
        "description": "Publish workflow (Draft -> Active, Version++)",
        "response": "WorkflowDefinition",
        "status": 200
      },
      {
        "method": "POST",
        "path": "/api/workflows/{id}/start",
        "description": "Manually start a workflow instance",
        "body": "{entityId: string, context: object}",
        "response": "WorkflowInstance",
        "status": 200
      },
      {
        "method": "GET",
        "path": "/api/my-tasks",
        "description": "Get pending tasks for current user",
        "query": "?userId={id}",
        "response": "[{tokenId, taskName, dueAt, ...}]",
        "status": 200
      },
      {
        "method": "POST",
        "path": "/api/my-tasks/{tokenId}/complete",
        "description": "Complete a user task",
        "body": "{outcome: string, data: object}",
        "response": "{success: true}",
        "status": 200
      },
      {
        "method": "GET",
        "path": "/api/workflow-instances",
        "description": "List workflow instances",
        "query": "?entityType={type}&status={status}",
        "response": "[{instanceId, status, currentNode}]",
        "status": 200
      }
    ]
  },
  "requestHeaders": {
    "contentType": "application/json",
    "cors": "Enabled for development (Vite proxy)"
  },
  "responseFormat": {
    "success": {
      "status": 200,
      "body": "JSON data"
    },
    "error": {
      "status": "400 | 404 | 500",
      "body": "{error: 'Error message'}"
    }
  },
  "autoLinkingBehavior": {
    "implementedDate": "2025-11-08",
    "description": "Backend automatically maintains app-page relationships",
    "savePage": "Adds pageId to app.pages[] if not present, updates timestamp",
    "deletePage": "Removes pageId from app.pages[], updates timestamp",
    "file": "app-bana-service/src/main/java/com/appbana/AppManager.java",
    "atomicity": "Single PUT /apps/{appId}/pages/{pageId} is sufficient"
  },
  "frontendClient": {
    "file": "app-bana-ui/src/core/api-client.ts",
    "class": "ApiClient",
    "baseURL": "http://localhost:8080",
    "methods": [
      "get",
      "post",
      "put",
      "delete"
    ],
    "usage": "import { apiClient } from './api-client';",
    "example": [
      "const result = await apiClient.get<{apps: AppListItem[]}>('/apps');",
      "const apps = result.apps || [];",
      "const created = await apiClient.post('/apps', appData);",
      "await apiClient.put('/apps/my-app', updates);",
      "await apiClient.delete('/apps/my-app');"
    ]
  },
  "auditLogging": {
    "file": "app-bana-service/src/main/java/com/appbana/AuditLogService.java",
    "table": "audit_log",
    "actions": [
      "INSERT",
      "UPDATE",
      "DELETE",
      "BATCH_INSERT"
    ],
    "fields": [
      "id",
      "entity",
      "entityId",
      "action",
      "userId",
      "before",
      "after",
      "diff",
      "timestamp"
    ],
    "diffFormat": "JSON array of changed fields with before/after values"
  }
}