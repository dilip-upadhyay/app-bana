{
  "metaVersion" : 1,
  "id" : "approvals",
  "name" : "Pending Approvals",
  "path" : "/approvals",
  "rootId" : "root",
  "nodes" : [ {
    "id" : "root",
    "type" : "container",
    "props" : {
      "style" : "padding: 40px; margin: 0 auto; max-width: 1200px;"
    },
    "children" : [ "header", "grid-card" ]
  }, {
    "id" : "header",
    "type" : "container",
    "props" : {
      "style" : "margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between;"
    },
    "children" : [ "title-grp", "home-btn" ]
  }, {
    "id" : "title-grp",
    "type" : "container",
    "children" : [ "title", "subtitle" ]
  }, {
    "id" : "title",
    "type" : "text",
    "props" : {
      "tag" : "h2",
      "text" : "Pending Approvals",
      "style" : "margin: 0; color: #1e293b;"
    }
  }, {
    "id" : "subtitle",
    "type" : "text",
    "props" : {
      "tag" : "p",
      "text" : "Review and action pending loan applications",
      "style" : "margin: 4px 0 0 0; color: #64748b;"
    }
  }, {
    "id" : "home-btn",
    "type" : "button",
    "props" : {
      "text" : "← Dashboard",
      "style" : "background: white; border: 1px solid #e2e8f0; padding: 8px 16px; border-radius: 6px; cursor: pointer;",
      "onClick" : "navigate('/')",
      "label" : "Dashboard"
    }
  }, {
    "id" : "grid-card",
    "type" : "container",
    "props" : {
      "style" : "background: white; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); overflow: hidden;"
    },
    "children" : [ "grid" ]
  }, {
    "id" : "grid",
    "type" : "grid",
    "props" : {
      "entity" : "LoanApplication",
      "filter" : "status eq 'PENDING'",
      "fields" : [ {
        "name" : "applicantName",
        "label" : "Applicant"
      }, {
        "name" : "amount",
        "label" : "Amount",
        "format" : "currency"
      }, {
        "name" : "purpose",
        "label" : "Purpose"
      }, {
        "name" : "creditScore",
        "label" : "Score"
      }, {
        "name" : "created",
        "label" : "Date",
        "format" : "date"
      } ],
      "actions" : [ {
        "label" : "Review",
        "onClick" : "navigate('/review?id=' + row.id)"
      } ]
    }
  } ]
}