{
  "metaVersion" : 1,
  "id" : "apply",
  "name" : "Apply for Loan",
  "path" : "/apply",
  "rootId" : "root",
  "nodes" : [ {
    "id" : "root",
    "type" : "container",
    "props" : {
      "style" : "padding: 40px; max-width: 600px; margin: 0 auto;"
    },
    "children" : [ "header", "form-card" ]
  }, {
    "id" : "header",
    "type" : "container",
    "props" : {
      "style" : "margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between;"
    },
    "children" : [ "title", "back-btn" ]
  }, {
    "id" : "back-btn",
    "type" : "button",
    "props" : {
      "label" : "← Home",
      "style" : "background: none; border: none; color: #64748b; cursor: pointer;",
      "onClick" : "navigate('/')"
    }
  }, {
    "id" : "title",
    "type" : "text",
    "props" : {
      "tag" : "h2",
      "text" : "New Loan Application",
      "style" : "margin: 0; color: #1e293b;"
    }
  }, {
    "id" : "form-card",
    "type" : "container",
    "props" : {
      "style" : "background: white; padding: 32px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);"
    },
    "children" : [ "form" ]
  }, {
    "id" : "form",
    "type" : "form",
    "props" : {
      "entity" : "LoanApplication",
      "redirectOnSuccess" : "/"
    },
    "children" : [ "f-name", "f-amount", "f-purpose", "f-score", "f-status", "submit-btn" ]
  }, {
    "id" : "f-status",
    "type" : "input",
    "props" : {
      "name" : "status",
      "type" : "hidden",
      "value" : "PENDING"
    }
  }, {
    "id" : "f-name",
    "type" : "input",
    "props" : {
      "name" : "applicantName",
      "label" : "Full Name",
      "placeholder" : "John Doe",
      "required" : true
    }
  }, {
    "id" : "f-amount",
    "type" : "input",
    "props" : {
      "name" : "amount",
      "type" : "number",
      "label" : "Loan Amount ($)",
      "placeholder" : "50000",
      "required" : true
    }
  }, {
    "id" : "f-purpose",
    "type" : "select",
    "props" : {
      "name" : "purpose",
      "label" : "Loan Purpose",
      "required" : true,
      "options" : [ {
        "label" : "Home Improvement",
        "value" : "Home Improvement"
      }, {
        "label" : "Debt Consolidation",
        "value" : "Debt Consolidation"
      }, {
        "label" : "Business",
        "value" : "Business"
      }, {
        "label" : "Personal",
        "value" : "Personal"
      } ]
    }
  }, {
    "id" : "f-score",
    "type" : "input",
    "props" : {
      "name" : "creditScore",
      "type" : "number",
      "label" : "Credit Score",
      "placeholder" : "750",
      "required" : true
    }
  }, {
    "id" : "submit-btn",
    "type" : "button",
    "props" : {
      "label" : "Submit Application",
      "type" : "submit",
      "style" : "width: 100%; margin-top: 24px; padding: 12px; background: #3b82f6; color: white; border-radius: 6px; border: none; font-weight: 600;"
    }
  } ]
}