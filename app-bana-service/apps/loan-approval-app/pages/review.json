{
    "metaVersion": 1,
    "id": "review",
    "name": "Review Application",
    "path": "/review",
    "rootId": "root",
    "nodes": [
        {
            "id": "root",
            "type": "container",
            "props": {
                "style": "padding: 40px; max-width: 800px; margin: 0 auto;"
            },
            "children": [
                "header",
                "details-card"
            ]
        },
        {
            "id": "header",
            "type": "container",
            "props": {
                "style": "margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between;"
            },
            "children": [
                "title",
                "cancel-btn"
            ]
        },
        {
            "id": "title",
            "type": "text",
            "props": {
                "tag": "h2",
                "text": "Review Application",
                "style": "margin: 0; color: #1e293b;"
            }
        },
        {
            "id": "cancel-btn",
            "type": "button",
            "props": {
                "label": "Cancel",
                "style": "background: none; border: none; color: #64748b; cursor: pointer;",
                "onClick": "navigate('/approvals')"
            }
        },
        {
            "id": "details-card",
            "type": "container",
            "props": {
                "style": "background: white; padding: 32px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);"
            },
            "children": [
                "decision-form"
            ]
        },
        {
            "id": "decision-form",
            "type": "form",
            "props": {
                "entity": "LoanApplication",
                "recordId": "{{query.id}}",
                "redirectOnSuccess": "/approvals"
            },
            "children": [
                "group-applicant",
                "f-comments",
                "f-status-hidden",
                "actions-row"
            ]
        },
        {
            "id": "group-applicant",
            "type": "container",
            "props": {
                "style": "display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; padding-bottom: 24px; border-bottom: 1px solid #f1f5f9;"
            },
            "children": [
                "f-name",
                "f-amount",
                "f-score",
                "f-purpose"
            ]
        },
        {
            "id": "f-name",
            "type": "input",
            "props": {
                "name": "applicantName",
                "label": "Applicant Name",
                "readOnly": true
            }
        },
        {
            "id": "f-amount",
            "type": "input",
            "props": {
                "name": "amount",
                "label": "Loan Amount",
                "readOnly": true
            }
        },
        {
            "id": "f-score",
            "type": "input",
            "props": {
                "name": "creditScore",
                "label": "Credit Score",
                "readOnly": true
            }
        },
        {
            "id": "f-purpose",
            "type": "input",
            "props": {
                "name": "purpose",
                "label": "Purpose",
                "readOnly": true
            }
        },
        {
            "id": "f-comments",
            "type": "textarea",
            "props": {
                "name": "managerComments",
                "label": "Manager Comments",
                "placeholder": "Reason for approval/rejection...",
                "rows": 4
            }
        },
        {
            "id": "f-status-hidden",
            "type": "input",
            "props": {
                "name": "status",
                "type": "hidden"
            }
        },
        {
            "id": "actions-row",
            "type": "container",
            "props": {
                "style": "display: flex; gap: 16px; margin-top: 24px;"
            },
            "children": [
                "reject-btn",
                "approve-btn"
            ]
        },
        {
            "id": "approve-btn",
            "type": "button",
            "props": {
                "label": "✅ Approve Loan",
                "type": "submit",
                "style": "flex: 1; padding: 12px; background: #10b981; color: white; border-radius: 6px; border: none; font-weight: 600; cursor: pointer;",
                "updateField": "status",
                "updateValue": "APPROVED"
            }
        },
        {
            "id": "reject-btn",
            "type": "button",
            "props": {
                "label": "❌ Reject Loan",
                "type": "submit",
                "style": "flex: 1; padding: 12px; background: #ef4444; color: white; border-radius: 6px; border: none; font-weight: 600; cursor: pointer;",
                "updateField": "status",
                "updateValue": "REJECTED"
            }
        }
    ]
}