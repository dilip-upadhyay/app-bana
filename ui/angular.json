{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "studio": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/studio",
      "sourceRoot": "projects/studio/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/studio/src/main.ts",
            "tsConfig": "projects/studio/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/studio/public"
              }
            ],
            "styles": [
              "projects/studio/src/styles.scss"
            ],
            "server": "projects/studio/src/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "projects/studio/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "studio:build:production"
            },
            "development": {
              "buildTarget": "studio:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/studio/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/studio/public"
              }
            ],
            "styles": [
              "projects/studio/src/styles.scss"
            ]
          }
        }
      }
    },
    "runtime": {
      "projectType": "library",
      "root": "projects/runtime",
      "sourceRoot": "projects/runtime/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/runtime/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/runtime/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/runtime/tsconfig.spec.json"
          }
        }
      }
    },
    "designer": {
      "projectType": "library",
      "root": "projects/designer",
      "sourceRoot": "projects/designer/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/designer/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/designer/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/designer/tsconfig.spec.json"
          }
        }
      }
    },
    "ui-schema": {
      "projectType": "library",
      "root": "projects/ui-schema",
      "sourceRoot": "projects/ui-schema/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ui-schema/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ui-schema/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/ui-schema/tsconfig.spec.json"
          }
        }
      }
    },
    "ui-material": {
      "projectType": "library",
      "root": "projects/ui-material",
      "sourceRoot": "projects/ui-material/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ui-material/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ui-material/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/ui-material/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
