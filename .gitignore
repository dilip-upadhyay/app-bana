# ============================================================
# AppBana .gitignore
# ============================================================

# --- Build outputs ---
target/
build/
dist/
*.jar
*.class

# --- Generated sources ---
generated-sources/
generated-test-sources/

# --- IDE / OS ---
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# --- Logs & PIDs ---
*.log
*.pid

# --- Local runtime data ---
data/
**/data/
qdrant_storage/
dev-logs/
logs/
app-bana-service/uploads/

# --- E2E test artifacts ---
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/.auth/

# --- Node / frontend ---
node_modules/
/app-bana-ui/src/main/resources/ui/dist/
/app-bana-ui/package-lock.json

# --- TypeScript build artifacts ---
# `tsc -b` emits these next to their sources in the pnpm workspace packages.
# They are pure build output: the .tsbuildinfo files churn on every compile and
# the vite.config.{js,d.ts} pair is generated from vite.config.ts.
*.tsbuildinfo
app-bana-studio/vite.config.js
app-bana-studio/vite.config.d.ts
app-bana-runtime/vite.config.js
app-bana-runtime/vite.config.d.ts

# --- Secrets / env ---
.env