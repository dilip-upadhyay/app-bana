# ============================================================
# AppBana .gitignore
# ============================================================

# --- Build outputs ---
target/
build/
dist/
*.jar
*.class

# --- Generated sources ---
generated-sources/
generated-test-sources/

# --- IDE / OS ---
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# --- Logs & PIDs ---
*.log
*.pid

# --- Local runtime data ---
data/
**/data/
qdrant_storage/
dev-logs/
logs/

# --- E2E test artifacts ---
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/.auth/

# --- Node / frontend ---
node_modules/
/app-bana-ui/src/main/resources/ui/dist/
/app-bana-ui/package-lock.json

# --- Secrets / env ---
.env