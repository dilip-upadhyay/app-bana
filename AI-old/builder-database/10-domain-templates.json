{
  "version": "2025-11-16",
  "description": "Domain-level app scaffolding templates used by AI Builder fallback generation.",
  "templates": [
    {
      "domain": "running",
      "appName": "Running Tracker",
      "description": "Track runs, training plans, and performance metrics",
      "entities": [
        {
          "name": "RunSession",
          "fields": [
            {"name": "id", "type": "long", "primaryKey": true, "autoIncrement": true},
            {"name": "date", "type": "date"},
            {"name": "distance_km", "type": "decimal"},
            {"name": "duration_min", "type": "int"},
            {"name": "pace", "type": "string"},
            {"name": "notes", "type": "string"}
          ]
        },
        {
          "name": "TrainingPlan",
          "fields": [
            {"name": "id", "type": "long", "primaryKey": true, "autoIncrement": true},
            {"name": "name", "type": "string"},
            {"name": "goal_distance_km", "type": "decimal"},
            {"name": "target_race", "type": "string"},
            {"name": "weeks", "type": "int"}
          ]
        }
      ],
      "relationships": ["RunSession relates to TrainingPlan (optional future expansion)"] ,
      "suggestedPages": [
        "Run Sessions List (Data Table)",
        "Run Session Detail (Profile)",
        "Create Run Session (Form)"
      ]
    },
    {
      "domain": "dance",
      "appName": "Dance Application",
      "description": "Dance tutorials, videos and events",
      "entities": [
        {
          "name": "DanceVideo",
          "fields": [
            {"name": "id", "type": "long", "primaryKey": true, "autoIncrement": true},
            {"name": "title", "type": "string"},
            {"name": "style", "type": "string"},
            {"name": "difficulty", "type": "string"},
            {"name": "length_min", "type": "int"}
          ]
        },
        {
          "name": "Event",
          "fields": [
            {"name": "id", "type": "long", "primaryKey": true, "autoIncrement": true},
            {"name": "name", "type": "string"},
            {"name": "date", "type": "date"},
            {"name": "location", "type": "string"}
          ]
        }
      ],
      "suggestedPages": [
        "Videos List (Data Table)",
        "Video Detail (Profile)",
        "Create Video (Form)"
      ]
    },
    {
      "domain": "blog",
      "appName": "Blog Application",
      "description": "Posts and comments publishing",
      "entities": [
        {
          "name": "Post",
          "fields": [
            {"name": "id", "type": "long", "primaryKey": true, "autoIncrement": true},
            {"name": "title", "type": "string"},
            {"name": "content", "type": "string"},
            {"name": "author", "type": "string"},
            {"name": "published_at", "type": "date"},
            {"name": "status", "type": "string"}
          ]
        },
        {
          "name": "Comment",
          "fields": [
            {"name": "id", "type": "long", "primaryKey": true, "autoIncrement": true},
            {"name": "content", "type": "string"},
            {"name": "author", "type": "string"},
            {"name": "post_id", "type": "long"}
          ]
        }
      ],
      "relationships": ["Comment.post_id → Post.id (many-to-one, CASCADE DELETE)"] ,
      "suggestedPages": [
        "Posts List (Data Table)",
        "Post Detail (Profile)",
        "Create Post (Form)"
      ]
    },
    {
      "domain": "task",
      "appName": "Task Manager",
      "description": "Tasks with status and priority",
      "entities": [
        {
          "name": "Task",
          "fields": [
            {"name": "id", "type": "long", "primaryKey": true, "autoIncrement": true},
            {"name": "title", "type": "string"},
            {"name": "description", "type": "string"},
            {"name": "status", "type": "string"},
            {"name": "priority", "type": "string"},
            {"name": "due_date", "type": "date"}
          ]
        }
      ],
      "suggestedPages": [
        "Task List (Data Table)",
        "Task Detail (Profile)",
        "Create Task (Form)"
      ]
    },
    {
      "domain": "ecommerce",
      "appName": "E-Commerce Store",
      "description": "Products catalog",
      "entities": [
        {
          "name": "Product",
          "fields": [
            {"name": "id", "type": "long", "primaryKey": true, "autoIncrement": true},
            {"name": "name", "type": "string"},
            {"name": "description", "type": "string"},
            {"name": "price", "type": "long"},
            {"name": "stock", "type": "int"},
            {"name": "category", "type": "string"}
          ]
        }
      ],
      "suggestedPages": [
        "Product Catalog (Data Table)",
        "Product Detail (Profile)"
      ]
    },
    {
      "domain": "crm",
      "appName": "CRM Application",
      "description": "Customer and contact tracking",
      "entities": [
        {
          "name": "Contact",
          "fields": [
            {"name": "id", "type": "long", "primaryKey": true, "autoIncrement": true},
            {"name": "first_name", "type": "string"},
            {"name": "last_name", "type": "string"},
            {"name": "email", "type": "string"},
            {"name": "phone", "type": "string"},
            {"name": "company", "type": "string"},
            {"name": "status", "type": "string"}
          ]
        }
      ],
      "suggestedPages": [
        "Contacts List (Data Table)",
        "Contact Detail (Profile)"
      ]
    }
  ]
}

